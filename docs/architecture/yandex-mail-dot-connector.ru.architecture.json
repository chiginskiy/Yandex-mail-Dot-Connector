  "cards": [
    {
      "dot": "emerald",
      "title": "Путь чтения почты",
      "items": [
        "Пять MCP-инструментов отображаются на фиксированный allowlist маршрутов bridge.",
        "Identity владельца проверяется приватным Site до выполнения инструмента.",
        "Каждый запрос к bridge подписывается заново; операции чтения используют короткие read-only IMAP-сессии."
      ]
    },
    {
      "dot": "violet",
      "title": "Изоляция credentials",
      "items": [
        "Site D1 хранит приватный Ed25519 signing key и никогда не хранит mail token.",
        "Bridge D1 хранит привязанный к владельцу Yandex access token, OAuth state и использованные nonce.",
        "Refresh token намеренно отбрасывается; истечение или отзыв требуют явной повторной авторизации."
      ]
    },
    {
      "dot": "rose",
      "title": "Границы доверия",
      "items": [
        "Site adapter безопасен только за аутентифицированным приватным Sites hosting.",
        "Callback bridge публичен, а mail routes и OAuth-start требуют подписанного запроса, привязанного к владельцу.",
        "Содержимое почты, имена папок и вложения остаются недоверенными входными данными."
      ]
    },
    {
      "dot": "amber",
      "title": "Операционные ограничения",
      "items": [
        "Perimeter limiter срабатывает до криптографии/D1; owner limiter — после проверки подписи.",
        "Кэш почтового ящика и connection pool не поддерживаются; на запрос открывается отдельное IMAP-соединение.",
        "Тела писем, MIME-обход, папки, ответы и чанки вложений имеют явные лимиты."
      ]
    }
  ]
