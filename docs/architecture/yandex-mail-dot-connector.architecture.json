  "cards": [
    {
      "dot": "emerald",
      "title": "Mail read path",
      "items": [
        "Five MCP tools map to a fixed bridge route allowlist.",
        "Owner identity is validated at the private Site before tool execution.",
        "Each bridge request is freshly signed; read operations use short read-only IMAP sessions."
      ]
    },
    {
      "dot": "violet",
      "title": "Credential isolation",
      "items": [
        "Site D1 keeps the Ed25519 private signing key and never stores the mail token.",
        "Bridge D1 keeps the owner-bound Yandex access token, OAuth state and used nonces.",
        "The refresh token is deliberately discarded; expiry or revocation requires explicit reauthorization."
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "The Site adapter is safe only behind authenticated private Sites hosting.",
        "The bridge callback is public, while mail and OAuth-start routes require signed owner-bound requests.",
        "Mailbox content, folder names and attachments remain untrusted input."
      ]
    },
    {
      "dot": "amber",
      "title": "Operational bounds",
      "items": [
        "Perimeter limiting runs before cryptography/D1; owner limiting runs after signature verification.",
        "No mailbox cache or connection pool is kept; one IMAP connection is used per request.",
        "Message bodies, MIME traversal, folders, responses and attachment chunks are explicitly bounded."
      ]
    }
  ]
