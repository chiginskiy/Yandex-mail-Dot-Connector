{
  "name": "yandex-mail-readonly-bridge",
  "main": "src/bridge-wrapper.mjs",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false },
  "ratelimits": [
    {"name":"PERIMETER_LIMITER","namespace_id":"71001","simple":{"limit":120,"period":60}},
    {"name":"OWNER_LIMITER","namespace_id":"71002","simple":{"limit":30,"period":60}}
  ],
  "vars": { "ALLOWED_MAILBOXES": "[\"INBOX\"]" }
}
